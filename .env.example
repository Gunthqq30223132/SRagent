# --- Notion (bắt buộc để publish thật; thiếu thì pipeline chạy dry-run) ---
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=

# --- IEEE Xplore Metadata API (nguồn Loại A — đăng ký miễn phí tại developer.ieee.org) ---
IEEE_API_KEY=

# --- Ollama (Structural Parser) ---
OLLAMA_BASE_URL=http://localhost:11434
# Mặc định: chính xác schema tốt nhất phân khúc 7B (Q4 ~4.7GB)
OLLAMA_MODEL=qwen2.5:7b-instruct
# Profile "fast" cho máy đang bận RAM: nhẹ hơn ~30%, context 128k, kém ổn định hơn ở schema lồng nhau
# OLLAMA_MODEL=gemma3:4b

# --- Screening song thẩm (M7.2) ---
# Hai screener PHẢI khác model (độc lập rater — cùng model là mất giá trị kiểm chéo).
# Tag phải có trong `ollama list` ĐÚNG TỪNG KÝ TỰ; tag sai → hệ fallback ỒN ÀO
# (SCREEN_MODEL_A_FALLBACK / SCREEN_SINGLE_MODEL) chứ không chết lặng.
# SR_SCREEN_MODEL_A=llama3.1:8b        # bỏ trống = dùng OLLAMA_MODEL
SR_SCREEN_MODEL_B=gemma4:e4b

# --- Staging ---
SR_AGENT_DB=staging/sr_agent.db

# --- Alerting (M4, tùy chọn) ---
# Webhook nhận báo động khi hạ tầng sập/hồi phục. Tương thích:
#   ntfy.sh (khuyến nghị — push tới điện thoại, không cần server): https://ntfy.sh/<topic-cua-ban>
#   Slack incoming webhook / Discord webhook: dán URL webhook tương ứng
# Thiếu biến này: alert hiện qua Notification Center của macOS (mặc định, local).
ALERT_WEBHOOK_URL=
