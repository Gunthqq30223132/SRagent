# --- Notion (bắt buộc để publish thật; thiếu thì pipeline chạy dry-run) ---
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=

# --- IEEE Xplore Metadata API (nguồn Loại A — đăng ký miễn phí tại developer.ieee.org) ---
IEEE_API_KEY=

# --- PubMed / NCBI E-utilities (nguồn y khoa) ---
# EMAIL LÀ BẮT BUỘC, không phải tùy chọn. Chính sách NCBI đòi mọi truy vấn tự động
# phải kèm tool + email; thiếu email thì NCBI chuyển hướng sang trang chặn
# misuse.ncbi.nlm.nih.gov và trả HTML thay vì dữ liệu (HTTP vẫn 200 — chặn mềm).
NCBI_EMAIL=
# Khóa API miễn phí, lấy 2 phút tại: https://account.ncbi.nlm.nih.gov/settings/
# (đăng nhập -> API Key Management -> Create an API Key)
# Không có khóa: 3 truy vấn/giây. Có khóa: 10/giây, và IP được định danh riêng
# nên không bị vạ lây khi IP dùng chung bị nơi khác lạm dụng.
NCBI_API_KEY=

# --- Ollama (Structural Parser) ---
OLLAMA_BASE_URL=http://localhost:11434
# Mặc định: chính xác schema tốt nhất phân khúc 7B (Q4 ~4.7GB)
OLLAMA_MODEL=qwen2.5:7b-instruct
# Profile "fast" cho máy đang bận RAM: nhẹ hơn ~30%, context 128k, kém ổn định hơn ở schema lồng nhau
# OLLAMA_MODEL=gemma3:4b

# --- Staging ---
SR_AGENT_DB=staging/sr_agent.db

# --- Alerting (M4, tùy chọn) ---
# Webhook nhận báo động khi hạ tầng sập/hồi phục. Tương thích:
#   ntfy.sh (khuyến nghị — push tới điện thoại, không cần server): https://ntfy.sh/<topic-cua-ban>
#   Slack incoming webhook / Discord webhook: dán URL webhook tương ứng
# Thiếu biến này: alert hiện qua Notification Center của macOS (mặc định, local).
ALERT_WEBHOOK_URL=
